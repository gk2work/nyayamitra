# ═══════════════════════════════════════════════════════════════════════════════
# NYAYAMITRA — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control. Only .env.example is tracked.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=nyayamitra
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ─── Backend (FastAPI) ───────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_WORKERS=1
BACKEND_LOG_LEVEL=INFO

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=NyayaMitra

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nyayamitra
POSTGRES_USER=nyayamitra
POSTGRES_PASSWORD=change-this-password

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Qdrant (Vector Database) ───────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# ─── Elasticsearch ───────────────────────────────────────────────────────────
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=change-this-password

# ─── Neo4j (Knowledge Graph) ────────────────────────────────────────────────
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password

# ─── LLM Inference (vLLM) ───────────────────────────────────────────────────
VLLM_HOST=vllm
VLLM_PORT=8000
VLLM_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90

# ─── Embedding Model ────────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# ─── Re-ranker ──────────────────────────────────────────────────────────────
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-12-v2
RERANKER_TOP_K=15

# ─── Retrieval Configuration ────────────────────────────────────────────────
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_SPARSE=20
RETRIEVAL_RRF_K=60
RETRIEVAL_FINAL_TOP_K=10

# ─── Citation Verifier ──────────────────────────────────────────────────────
CITATION_VERIFICATION_ENABLED=true
CITATION_FAILURE_THRESHOLD=0.3

# ─── Data Ingestion ─────────────────────────────────────────────────────────
INDIAN_KANOON_API_URL=https://api.indiankanoon.org
INDIAN_KANOON_API_TOKEN=
SCRAPER_RATE_LIMIT_REQUESTS=10
SCRAPER_RATE_LIMIT_PERIOD=1
SCRAPER_RETRY_MAX=3
SCRAPER_RETRY_BACKOFF=2.0

# ─── Security ────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
ENCRYPTION_KEY=
